---
// Sonic 1 title card: black bg, "OPENGGF" (caps, white Schola serif) over a solid
// lavender blob, with "VER <short>" on the blob — VER small orange, version big yellow
// (mirrors the real "ACT 1"). The composition is absolutely centred so the tagline/CTAs
// below never shift the blob. Version pruned to major.minor (hidden if unparseable).
//
// The slide-in is translated from the engine (Sonic1TitleCardManager +
// Sonic1TitleCardMappings, GHZ CON_DATA), same convention as the S2 hero in animate.ts:
// every element starts on frame 0 (S1 authors no per-element delay), travels at a
// constant 16 px/frame — so `linear`, never an ease — and simply arrives late if it
// started further out. Travel is expressed in vw as a fraction of the game's 320-wide
// frame, so each element crosses the same proportion of the screen it does in-game.
//
//   engine element  start→target   px   frames  web element
//   zone name       -128 → 160     288    18     .s1-name    (from left,  90vw)
//   oval             404 → 212     192    12     .s1-blob    (from right, 60vw)
//   "ZONE"          -388 → 188     576    36     .s1-tagline (from left, 180vw)
//   act number       916 → 212     704    44     .s1-ver     (from right, 220vw)
import { shortVersion } from '../lib/releases';
import { PROMO_VIDEO_S1 } from '../lib/media';
interface Props { version: { label: string; isPre: boolean } | null; }
const { version } = Astro.props;
const ver = shortVersion(version);
---
<section class="s1" data-hero="s1" aria-label="OpenGGF — Fan-Made Open-Source Sonic Engine">
  <!-- promo video behind everything; the black cover above it fades ~1s after the
       title card finishes animating, revealing the video under the title elements -->
  <div class="s1-video" aria-hidden="true">
    <video class="promo-video" muted loop playsinline preload="auto">
      <source src={PROMO_VIDEO_S1} type="video/mp4" />
    </video>
  </div>
  <div class="s1-cover" aria-hidden="true"></div>

  <div class="s1-stage">
    <div class="s1-blob" aria-hidden="true"></div>
    <h1 class="s1-name">OpenGGF</h1>
    {ver && <div class="s1-ver"><span>VER</span><b>{ver}</b></div>}
  </div>
  <p class="s1-tagline">Fan-Made Open-Source Sonic Engine</p>
  <div class="s1-ctas">
    <a class="s1-btn p" href="/#download">⬇ Download</a>
    <a class="s1-btn s" href="/docs">Read the docs</a>
  </div>
</section>

<style>
  /* seconds per engine frame. The game runs at 60fps (1/60s); the web card runs the
     same frame counts at roughly half speed so the choreography is legible at this
     scale — the same 0.032 SPF the S2 hero uses in animate.ts. */
  .s1 { --s1-spf: 0.032s;
    position: relative; width: 100%; height: clamp(480px, 84vh, 820px);
    overflow: hidden; background: #000; isolation: isolate; }

  /* promo video layer (cover-fit, behind all title elements). The clip is native
     320x224 pixel art, so upscale it nearest-neighbour (crisp pixels, like the game). */
  .s1-video { position: absolute; inset: 0; z-index: 0; }
  .s1-video video { width: 100%; height: 100%; object-fit: cover; display: block;
    image-rendering: pixelated; }
  /* Fades from opaque to a ~25% scrim, revealing the video while keeping it dimmed so
     the title elements stay legible. Starts at 2.41s = the last element landing (act,
     44 frames x --s1-spf = 1.41s) plus the engine's 60-frame DISPLAY hold. As in
     animate.ts the hold is kept at real time (1s) while motion runs at --s1-spf, so the
     pause reads as a pause rather than a stall. Reduced motion disables the animation,
     so it stays fully black (no video). */
  .s1-cover { position: absolute; inset: 0; z-index: 1; background: #000;
    animation: s1-reveal 1.2s ease-in 2.41s forwards; }

  /* composition centred independently of the tagline/CTAs below; above the cover */
  .s1-stage { position: absolute; left: 50%; top: 42%; transform: translate(-50%, -50%);
    display: inline-block; z-index: 3; }

  .s1-name {
    position: relative; z-index: 2; margin: 0; text-transform: uppercase; white-space: nowrap;
    font-family: var(--font-s1-text); font-weight: 700; color: #fff;
    font-size: clamp(40px, 8vw, 96px); letter-spacing: 2px; line-height: 1;
    /* hard black border offset down-right — legibility over the revealed video */
    text-shadow: 2px 2px 0 var(--ogf-ink);
    /* zone name: 288px at 16px/frame = 18 frames, from the left */
    animation: s1-name calc(18 * var(--s1-spf)) linear both;
  }
  /* lavender organic blob behind the wordmark's right end, vertically centred on it */
  .s1-blob {
    position: absolute; z-index: 0; right: -6%; top: 50%;
    width: 38%; aspect-ratio: 1.05; transform: translateY(-50%) rotate(-12deg);
    background: #9a9ae6; border-radius: 62% 38% 56% 44% / 58% 46% 54% 42%;
    /* oval: 192px at 16px/frame = 12 frames, from the right — the shortest travel, so
       it settles first, exactly as in-game */
    animation: s1-oval calc(12 * var(--s1-spf)) linear both;
  }
  /* VER (small orange) + version (big yellow), side by side on the blob — like "ACT 1" */
  .s1-ver {
    position: absolute; z-index: 3; right: 2%; top: 104%;
    display: flex; align-items: baseline; gap: 8px;
    /* act number: the longest run in the game — 704px at 16px/frame = 44 frames from
       far off the right, so it stays off-screen a while, then whips in and lands last */
    animation: s1-act calc(44 * var(--s1-spf)) linear both;
  }
  .s1-ver span { font-family: var(--font-s1-text); font-weight: 700; color: #ff8a00;
    font-size: clamp(15px, 1.7vw, 22px); letter-spacing: 1px;
    text-shadow: 2px 2px 0 var(--ogf-ink); }
  .s1-ver b { font-family: var(--font-s1-text); font-weight: 700; color: var(--ogf-yellow);
    font-size: clamp(30px, 3.6vw, 50px); line-height: 1;
    text-shadow: 2px 2px 0 var(--ogf-ink); }

  .s1-tagline {
    position: absolute; left: 0; right: 0; top: 74%; z-index: 4; text-align: center;
    font-family: var(--font-black); font-style: italic; font-size: clamp(18px, 3vw, 34px);
    color: #fff; -webkit-text-stroke: 2px var(--ogf-ink); paint-order: stroke fill;
    /* stands in for "ZONE", which sits under the zone name just as this sits under the
       wordmark: 576px at 16px/frame = 36 frames, from the left */
    animation: s1-zone calc(36 * var(--s1-spf)) linear both;
  }
  .s1-ctas {
    position: absolute; left: 0; right: 0; top: 85%; z-index: 4;
    display: flex; gap: 16px; justify-content: center;
    /* web-only — no counterpart on the game's card, so it simply follows the last
       engine element (act, 44 frames) in rather than inventing a slide of its own */
    animation: s1-inUp .3s ease-out calc(44 * var(--s1-spf)) both;
  }
  .s1-btn { font: 900 clamp(15px,1.8vw,20px) var(--font-body); padding: 15px 30px;
    border: 4px solid #fff; border-radius: 8px; text-decoration: none; box-shadow: 4px 4px 0 rgba(0,0,0,.5); }
  .s1-btn.p { background: var(--ogf-yellow); color: var(--ogf-ink); border-color: var(--ogf-ink); }
  .s1-btn.s { background: #111; color: #fff; }

  /* Travel only — no opacity fade on the four engine elements. In-game they are simply
     off-screen until they arrive, and fading them in reads as a different animation. */
  @keyframes s1-name { from { transform: translateX(-90vw); }  to { transform: none; } }
  @keyframes s1-zone { from { transform: translateX(-180vw); } to { transform: none; } }
  @keyframes s1-act  { from { transform: translateX(220vw); }  to { transform: none; } }
  /* keeps the blob's resting translateY(-50%)/rotate in both keyframes — animating a
     bare translateX here would drop them and make the blob jump as it lands */
  @keyframes s1-oval {
    from { transform: translate(60vw, -50%) rotate(-12deg); }
    to   { transform: translateY(-50%) rotate(-12deg); }
  }
  @keyframes s1-inUp { from { transform: translateY(30px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes s1-reveal { from { opacity: 1; } to { opacity: .25; } }

  @media (max-width: 640px) { .s1-ctas { flex-direction: column; align-items: center; } }
</style>
