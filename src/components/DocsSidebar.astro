---
interface Props { groups: { name: string; items: { title: string; slug: string }[] }[]; current: string; }
const { groups, current } = Astro.props;
---
<nav class="side">
  {groups.map((g) => (
    <div class="grp-block">
      <p class="grp">{g.name}</p>
      <ul>
        {g.items.map((it) => (
          <li><a href={`/docs/${it.slug}`} aria-current={it.slug === current ? 'page' : undefined}
            class={it.slug === current ? 'on' : ''}>{it.title}</a></li>
        ))}
      </ul>
    </div>
  ))}
</nav>
<style>
  .side { padding: 20px 12px; }
  .grp-block + .grp-block { margin-top: 18px; }
  .grp { font: 900 10px var(--font-body); text-transform: uppercase; letter-spacing: 1.2px;
    color: var(--ogf-blue); margin: 0 8px 8px; }
  .side ul { list-style: none; display: flex; flex-direction: column; gap: 1px; }
  .side a { display: block; padding: 7px 10px; border-radius: 6px; color: #3a3a42;
    font: 600 13.5px/1.35 var(--font-body); text-decoration: none; transition: background .12s, color .12s; }
  .side a:hover { background: #eceef6; color: var(--ogf-ink); }
  .side a.on { background: var(--ogf-blue); color: #fff; font-weight: 800; }
  .side a.on:hover { background: var(--ogf-blue); color: #fff; }
</style>
