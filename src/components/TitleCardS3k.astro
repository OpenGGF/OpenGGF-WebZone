---
// Sonic 3 & Knuckles title card: black bg, a tall RED vertical banner with "OPEN
// SOURCE" at its base (angular Andes font), next to "OpenGGF" in silver Andes with a
// grey offset shadow + "VER <short>". Banner + wordmark are grouped close together in
// the centre (not edge-bound). No "ZONE". Version pruned to major.minor (hidden if
// unparseable).
//
// Slide-in translated from the engine (Sonic3kTitleCardManager START_X/START_Y →
// TARGET_X/TARGET_Y), same convention as S1 and the S2 hero: no per-element delay,
// constant 16 px/frame — so `linear` — and travel expressed in vw/vh as a fraction of
// the game's 320x224 frame. The banner is the one vertical element (IS_VERTICAL[0]).
//
//   engine element   start→target   px   frames  web element
//   banner (Y)       -112 → 64      176    11     .s3k-banner  (from top,  78.6vh)
//   elem 1            480 → 160     320    20     .s3k-name    (from right, 100vw)
//   elem 2            636 → 252     384    24     .s3k-ver     (from right, 120vw)
//   elem 3            708 → 260     448    28     .s3k-tagline (from right, 140vw)
import { shortVersion } from '../lib/releases';
import { PROMO_VIDEO_S3K } from '../lib/media';
interface Props { version: { label: string; isPre: boolean } | null; }
const { version } = Astro.props;
const ver = shortVersion(version);
---
<section class="s3k" data-hero="s3k" aria-label="OpenGGF — Fan-Made Open-Source Sonic Engine">
  <!-- promo video behind everything; the black cover above it fades ~1s after the card
       finishes animating, revealing the video under the title elements (the rest stays) -->
  <div class="s3k-video" aria-hidden="true">
    <video class="promo-video" muted loop playsinline preload="auto">
      <source src={PROMO_VIDEO_S3K} type="video/mp4" />
    </video>
  </div>
  <div class="s3k-cover" aria-hidden="true"></div>

  <div class="s3k-group">
    <div class="s3k-banner"><span class="s3k-banner-label">OPEN<br />SOURCE</span></div>
    <div class="s3k-text">
      <div class="s3k-name">openggf</div>
      {ver && <div class="s3k-ver"><span>VER</span> <b>{ver}</b></div>}
    </div>
  </div>

  <p class="s3k-tagline">Fan-Made Open-Source Sonic Engine</p>
  <div class="s3k-ctas">
    <a class="s3k-btn p" href="/#download">⬇ Download</a>
    <a class="s3k-btn s" href="/docs">Read the docs</a>
  </div>
</section>

<style>
  /* seconds per engine frame — see S1/animate.ts: the game's 60fps frame counts run at
     roughly half speed so the choreography is legible at this scale. */
  .s3k { --s3k-spf: 0.032s;
    position: relative; width: 100%; height: clamp(480px, 84vh, 820px);
    overflow: hidden; background: #000; isolation: isolate;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: clamp(28px, 6vh, 64px); }

  /* promo video layer (cover-fit, behind all title elements). Native 320x224 pixel art,
     so upscale nearest-neighbour for crisp pixels like the game. */
  .s3k-video { position: absolute; inset: 0; z-index: 0; }
  .s3k-video video { width: 100%; height: 100%; object-fit: cover; display: block;
    image-rendering: pixelated; }
  /* Fades from opaque to a ~25% scrim, revealing the video while keeping it dimmed for
     legibility. Starts at 2.4s = the last element landing (28 frames x --s3k-spf =
     0.9s) plus the engine's DISPLAY_HOLD_FRAMES (90 frames), kept at real time (1.5s)
     while motion runs at --s3k-spf. Reduced motion disables the animation, so it stays
     fully black (no video). */
  .s3k-cover { position: absolute; inset: 0; z-index: 1; background: #000;
    animation: s3k-reveal 1.2s ease-in 2.4s forwards; }

  /* banner + wordmark grouped right next to each other, centred; above the cover */
  .s3k-group { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; gap: clamp(4px, 0.8vw, 12px); }

  .s3k-banner {
    width: clamp(90px, 11vw, 150px); height: clamp(260px, 46vh, 420px);
    background: var(--ogf-red); border: 4px solid var(--ogf-ink);
    display: flex; align-items: flex-end; justify-content: center; padding-bottom: 7%;
    /* the vertical element: 176px at 16px/frame = 11 frames, dropping from above.
       Shortest travel of the four, so the banner is in place first */
    animation: s3k-banner calc(11 * var(--s3k-spf)) linear both;
  }
  /* label NOT in the title font — a plain heavy sans, like a stamped sub-brand */
  .s3k-banner-label { font-family: var(--font-body); font-weight: 900; text-transform: uppercase;
    color: #fff; font-size: clamp(13px, 1.5vw, 20px); letter-spacing: 2px; text-align: center; line-height: 1.2; }

  .s3k-text { display: flex; flex-direction: column; align-items: flex-start; }
  .s3k-name {
    font-family: var(--font-s3k-text); color: #e9e9f2; font-size: clamp(44px, 8vw, 116px);
    line-height: .95; letter-spacing: 2px; padding: 0 .06em;
    /* grey block behind the bottom half of the text (as in the real S3&K card; no shadow) */
    background: linear-gradient(to bottom, transparent 0 52%, #3c3c46 52% 100%);
    /* elem 1: 320px at 16px/frame = 20 frames, from the right */
    animation: s3k-name calc(20 * var(--s3k-spf)) linear both;
  }
  /* version block aligned to the wordmark's right edge, in a plain heavy sans (NOT the
     title font) — reads as a spec stamp under the silver name */
  .s3k-ver {
    align-self: flex-end; display: inline-flex; align-items: baseline; gap: 8px; margin-top: .18em;
    font-family: var(--font-body);
    /* elem 2: 384px at 16px/frame = 24 frames, from the right */
    animation: s3k-ver calc(24 * var(--s3k-spf)) linear both;
  }
  .s3k-ver span { color: #fff; font-weight: 900; text-transform: uppercase;
    font-size: clamp(14px, 1.6vw, 22px); letter-spacing: 2px; }
  .s3k-ver b { color: var(--ogf-yellow); font-weight: 900; font-size: clamp(28px, 3.3vw, 46px);
    -webkit-text-stroke: 1px #0006; line-height: 1; }

  .s3k-tagline {
    position: relative; z-index: 2;
    font-family: var(--font-black); font-style: italic; font-size: clamp(17px, 2.6vw, 32px);
    color: #fff; -webkit-text-stroke: 2px var(--ogf-ink); paint-order: stroke fill; text-align: center;
    /* elem 3: 448px at 16px/frame = 28 frames, from the right — lands last */
    animation: s3k-tagline calc(28 * var(--s3k-spf)) linear both;
  }
  /* web-only — no counterpart on the game's card, so it follows the last engine
     element (elem 3, 28 frames) in rather than inventing a slide of its own */
  .s3k-ctas { position: relative; z-index: 2; display: flex; gap: 14px; justify-content: center;
    animation: s3k-inUp .3s ease-out calc(28 * var(--s3k-spf)) both; }
  .s3k-btn { font: 900 clamp(14px,1.7vw,19px) var(--font-body); padding: 14px 28px;
    border: 4px solid #fff; border-radius: 8px; text-decoration: none; box-shadow: 4px 4px 0 rgba(0,0,0,.5); }
  .s3k-btn.p { background: var(--ogf-yellow); color: var(--ogf-ink); border-color: var(--ogf-ink); }
  .s3k-btn.s { background: #111; color: #fff; }

  /* Travel only — no opacity fade on the four engine elements; in-game they are simply
     off-screen until they arrive. */
  @keyframes s3k-banner  { from { transform: translateY(-78.6vh); } to { transform: none; } }
  @keyframes s3k-name    { from { transform: translateX(100vw); }   to { transform: none; } }
  @keyframes s3k-ver     { from { transform: translateX(120vw); }   to { transform: none; } }
  @keyframes s3k-tagline { from { transform: translateX(140vw); }   to { transform: none; } }
  @keyframes s3k-inUp { from { transform: translateY(30px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes s3k-reveal { from { opacity: 1; } to { opacity: .25; } }

  @media (max-width: 640px) {
    .s3k-banner { height: clamp(180px, 30vh, 260px); }
    .s3k-name { font-size: clamp(40px, 12vw, 80px); }
    .s3k-ctas { flex-direction: column; align-items: center; }
  }
</style>
