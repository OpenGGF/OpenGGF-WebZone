---
// src/pages/news/[...slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedNews } from '../../lib/news';
import { formatNewsDate } from '../../lib/news-date';
import '../../styles/prose.css';
export async function getStaticPaths() {
  const posts = (await getPublishedNews());
  return posts.map((p, i) => ({
    params: { slug: p.id },
    props: { post: p, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<BaseLayout title={`${post.data.title} — OpenGGF`} description={post.data.summary}
  image={typeof post.data.image === 'string' ? post.data.image : post.data.image?.src} type="article">
  <div class="wrap">
    <a class="back" href="/news">← All news</a>
    <article class="post">
      <header class="head">
        <span class="tag">News</span>
        <h1>{post.data.title}</h1>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatNewsDate(post.data.date)}</time>
        <p class="lede">{post.data.summary}</p>
      </header>
      <div class="prose body"><Content /></div>
    </article>
    {(newer || older) && (
      <nav class="pager" aria-label="More news">
        {older ? <a class="older" href={`/news/${older.id}`}><small>← Older</small>{older.data.title}</a> : <span />}
        {newer && <a class="newer" href={`/news/${newer.id}`}><small>Newer →</small>{newer.data.title}</a>}
      </nav>
    )}
  </div>
</BaseLayout>
<style>
  /* The card leaves a 640px column: text and screenshots share it, and 640 is
     exactly twice the games' 320px screen, so 2x captures show pixel for pixel. */
  .wrap { max-width: 790px; margin: 0 auto; padding: clamp(28px, 6vh, 56px) 20px; }
  .back { display: inline-block; margin-bottom: 14px; font: 800 13px var(--font-body);
    color: var(--ogf-blue); text-decoration: none; }
  .back:hover { text-decoration: underline; }
  .post { background: #fff; border: 3px solid var(--ogf-ink); border-radius: 8px;
    padding: clamp(24px, 5vw, 44px) clamp(20px, 6vw, 52px) clamp(28px, 5vw, 48px); }
  .head { padding-bottom: 22px; margin-bottom: 8px; border-bottom: 2px solid #ececf3; }
  .tag { display: inline-block; background: var(--ogf-ink); color: #fff; font: 900 11px var(--font-body);
    text-transform: uppercase; letter-spacing: 1px; padding: 5px 12px; transform: skewX(-7deg); }
  .head h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(26px, 4.4vw, 38px);
    line-height: 1.12; margin: 14px 0 10px; }
  .head time { display: block; font: 700 12px var(--font-body); color: var(--ogf-blue);
    text-transform: uppercase; letter-spacing: .6px; }
  .lede { margin-top: 16px; font: 500 17px/1.6 var(--font-body); color: #3a3a42; }
  .body :global(> *) { max-width: none; }
  .body :global(img) { display: block; image-rendering: pixelated; }

  /* Posts read as articles, so a step up from the docs' 15px body text. */
  .body :global(p),
  .body :global(li) { font-size: 16px; }
  .body :global(h2:first-child) { margin-top: 28px; }
  .body :global(em) { color: #5a5a66; }

  .pager { display: flex; justify-content: space-between; gap: 14px; margin-top: 18px; }
  .pager a { flex: 0 1 48%; display: block; background: #fff; border: 3px solid var(--ogf-ink);
    border-radius: 8px; padding: 12px 16px; text-decoration: none; color: var(--ogf-ink);
    font: 800 14px/1.35 var(--font-body); }
  .pager a:hover { border-color: var(--ogf-blue); }
  .pager small { display: block; font: 700 11px var(--font-body); color: var(--ogf-blue);
    text-transform: uppercase; letter-spacing: .6px; margin-bottom: 4px; }
  .pager .newer { text-align: right; }
</style>
